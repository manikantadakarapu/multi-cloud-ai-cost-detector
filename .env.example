APP_NAME="Multi-Cloud AI Cost Detective"
APP_ENV=local
APP_VERSION=0.1.0
APP_DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://mcaicd:mcaicd@localhost:5432/mcaicd
POSTGRES_USER=mcaicd
POSTGRES_PASSWORD=mcaicd
POSTGRES_DB=mcaicd
POSTGRES_PORT=5432
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# --- Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-change-me-to-a-long-random-string-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_RATE_LIMIT_PER_MINUTE=60
AUTH_MAX_LOGIN_ATTEMPTS=5

# --- Shared cost-query infrastructure ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=60

# --- AWS ---
# AWS credentials are resolved via the default credential chain:
# 1. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars
# 2. ~/.aws/credentials (profile)
# 3. EC2/ECS/Lambda IAM roles
# Only set AWS_PROFILE if you want to override the default profile.
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_COST_EXPLORER_ENABLED=true
# Set true only for deterministic local demo data; false uses AWS Cost Explorer.
AWS_USE_MOCK_DATA=false

# --- Azure ---
# Azure credentials are resolved via DefaultAzureCredential by default.
# DefaultAzureCredential tries environment variables, managed identity,
# Azure CLI, and other token sources automatically.
# If AZURE_TENANT_ID, AZURE_CLIENT_ID, and AZURE_CLIENT_SECRET are all
# provided, the provider falls back to ClientSecretCredential explicitly.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=change-me-to-a-secure-client-secret
AZURE_COST_MANAGEMENT_ENABLED=true
AZURE_REQUEST_TIMEOUT=30

# --- GCP Billing ---
# GCP authentication uses Google Application Default Credentials (ADC).
# Create a service account, download its JSON key file, and point
# GOOGLE_APPLICATION_CREDENTIALS to the key file path. BigQuery billing
# export must be enabled in your GCP project; configure the project,
# dataset, and table that contain the exported billing data.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-service-account-key.json
GCP_BILLING_ENABLED=true
GCP_BILLING_ACCOUNT=00000000-0000-0000-0000-000000000000
GCP_BILLING_PROJECT=your-billing-project-id
GCP_BILLING_DATASET=billing_dataset
GCP_BILLING_TABLE=gcp_billing_export_v1_00000000_000000_000000

# --- Gemini cost insights (Sprint 1.5) ---
# AI insights explain deterministic cost events. They do not independently
# query or modify cloud resources. Leave AI_INSIGHT_ENABLED=false to keep
# the dashboard on rule-based insights only. Never commit a real API key.
GEMINI_API_KEY=
AI_INSIGHT_ENABLED=false
AI_INSIGHT_MODEL=gemini-2.0-flash
AI_INSIGHT_MAX_OUTPUT_TOKENS=512
AI_INSIGHT_TIMEOUT_SECONDS=12
AI_INSIGHT_PERCENTAGE_THRESHOLD=10.00
AI_INSIGHT_ABSOLUTE_THRESHOLD=50.00
AI_INSIGHT_MAX_EVENTS=3
AI_INSIGHT_CACHE_TTL_SECONDS=3600
# Cost alerts / SMTP notifications (Sprint 2.2)
ALERTS_SCHEDULER_ENABLED=false
ALERTS_EVALUATION_INTERVAL_SECONDS=900
ALERT_EMAIL_ENABLED=false
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
